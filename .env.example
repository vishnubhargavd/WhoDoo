# Copy to .env and adjust. Never commit .env.

# Local Postgres by default. For Supabase, paste the project's connection string
# (Settings -> Database). postgres:// and postgresql:// URLs are accepted as-is.
DATABASE_URL=postgresql+asyncpg://localhost/whodoo
# Set to 1 when connecting through the Supabase transaction pooler (port 6543).
DB_DISABLE_STATEMENT_CACHE=0

# Auth. See README_AUTH_BRIDGE.md.
# AUTH_MODE=local: tokens signed with JWT_SECRET; DEMO_AUTH=1 adds /dev/login (pick a seeded
#   user) and is refused unless DATABASE_URL is a local database.
# AUTH_MODE=supabase: Supabase access tokens only (ES256, keys from SUPABASE_URL's JWKS),
#   linked to users through users.auth_user_id (MemberCore migration 030). DEMO_AUTH must be 0.
# Do not set SUPABASE_JWT_SECRET: it is not used, and the app refuses to start if it is set.
AUTH_MODE=local
DEMO_AUTH=1
JWT_SECRET=change-me-to-a-long-random-string
# Optional tuning for AUTH_MODE=supabase (defaults shown; bounded 60-3600, 1-10, 0-60).
# SUPABASE_JWKS_CACHE_SECONDS=600
# SUPABASE_JWKS_TIMEOUT_SECONDS=5
# SUPABASE_JWT_LEEWAY_SECONDS=30

# Receipt storage. Leave blank to store receipts on local disk under UPLOAD_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=receipts
UPLOAD_DIR=uploads

# Claims below this amount need one approval; at or above it they need two.
EXPENSE_AUTO_APPROVAL_LIMIT=1000

# Payments: stripe | mock | auto (auto = Stripe when a test secret key is set).
# Without a usable sk_test_ key the app falls back to "Mock Payment (Stripe-compatible)".
# Keys: Stripe Dashboard -> Developers -> API keys, in Test mode. The secret key stays
# on the server; never commit it. Live keys (sk_live_) are refused.
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `make stripe-listen` (Stripe CLI). Optional: checkout completes without it.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the buyer back to after paying.
APP_BASE_URL=http://127.0.0.1:8000

# FairSeat ticket booking (Member 1). On by default; set to 0 to make its routes answer 404.
# It cannot be combined with DEMO_AUTH=1 on a database that is not local.
FAIRSEAT_ENABLED=1
# Paying for tickets is a second switch, also on. It uses the payment provider above.
FAIRSEAT_PAYMENTS_ENABLED=1
# Where the provider sends a ticket buyer back to. Blank = this app's /tickets/return page.
FAIRSEAT_RETURN_URL=
# Signs the QR code on every ticket. Needed (32+ characters) whenever FAIRSEAT_ENABLED=1 outside demo sign-in.
TICKET_CREDENTIAL_SECRET=

# --- Public event registration ---------------------------------------------------------
# Ticket emails. Leave SMTP_HOST empty and emails are written to MAIL_OUTBOX_DIR instead.
# Gmail: turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_OUTBOX_DIR=outbox
# Participant details are deleted this many days after the event ends.
REGISTRATION_RETENTION_DAYS=60
# How long a place is held while a paid registration is being paid for.
REGISTRATION_HOLD_SECONDS=1800
# Most registrations one address may submit in ten minutes (0 = no limit).
REGISTRATION_RATE_LIMIT=20

# --- From Member 2's Batch A -------------------------------------------------------------
# Encrypts stored UPI ids. Any string of 32+ characters. Blank is accepted only with demo sign-in.
PAYMENT_PROFILE_KEY=
# Membership renewal reminders: days before expiry, and how often the app writes them (0 = only
# when members open their pages).
RENEWAL_REMINDER_DAYS=30,14,7,1
RENEWAL_REMINDER_INTERVAL_SECONDS=3600
# Most unfinished tasks one person may hold before an assignment is flagged for review (0 = no limit).
CREW_MAX_OPEN_TASKS=0
