# Copy to .env and adjust. Never commit .env.

# Local Postgres by default. For Supabase, paste the project's connection string
# (Settings -> Database). postgres:// and postgresql:// URLs are accepted as-is.
DATABASE_URL=postgresql+asyncpg://localhost/whodoo
# Set to 1 when connecting through the Supabase transaction pooler (port 6543).
DB_DISABLE_STATEMENT_CACHE=0

# Auth. DEMO_AUTH=1 enables /dev/login (pick a seeded user). Turn off outside demos.
DEMO_AUTH=1
JWT_SECRET=change-me-to-a-long-random-string
# When the real auth module lands, set this to the Supabase JWT secret instead.
SUPABASE_JWT_SECRET=

# Receipt storage. Leave blank to store receipts on local disk under UPLOAD_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=receipts
UPLOAD_DIR=uploads

# Claims below this amount need one approval; at or above it they need two.
EXPENSE_AUTO_APPROVAL_LIMIT=1000

# Payments: stripe | mock | auto (auto = Stripe when a test secret key is set).
# Without a usable sk_test_ key the app falls back to "Mock Payment (Stripe-compatible)".
# Keys: Stripe Dashboard -> Developers -> API keys, in Test mode. The secret key stays
# on the server; never commit it. Live keys (sk_live_) are refused.
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `make stripe-listen` (Stripe CLI). Optional: checkout completes without it.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the buyer back to after paying.
APP_BASE_URL=http://127.0.0.1:8000

# FairSeat ticket booking (Member 1). Off by default; its routes answer 404.
# Its tables are a pending migration (migrations/pending/020_fairseat.sql) that
# `make migrate` does not apply, so leave this off until the team approves it.
# It cannot be combined with DEMO_AUTH=1 on a database that is not local.
FAIRSEAT_ENABLED=0
